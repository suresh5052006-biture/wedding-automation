rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Planners can only read/write their own document
    match /planners/{plannerId} {
      allow read, write: if request.auth != null && request.auth.uid == plannerId;
    }

    // Weddings - planners can only access their own weddings
    match /weddings/{weddingId} {
      allow read, write: if request.auth != null &&
        resource.data.plannerId == request.auth.uid ||
        request.resource.data.plannerId == request.auth.uid;

      // Vendors subcollection
      match /vendors/{vendorId} {
        allow read, write: if request.auth != null &&
          exists(/databases/$(database)/documents/weddings/$(weddingId)) &&
          get(/databases/$(database)/documents/weddings/$(weddingId)).data.plannerId == request.auth.uid;
      }
    }
  }
}
